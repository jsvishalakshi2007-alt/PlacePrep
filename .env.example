# PlacePrep Environment Variables Reference for Deployment (Vercel / Production)

# --- Backend / Serverless Function Environment Variables ---
# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/placeprep?retryWrites=true&w=majority

# JWT Authentication Secret (minimum 32 characters for security)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Node Environment
NODE_ENV=production

# Frontend Client URL (optional, defaults to wildcard / *.vercel.app)
CLIENT_URL=https://your-app.vercel.app

# Google OAuth Client ID (optional, for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudinary Storage (for Resume and Study File uploads in serverless environments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Frontend Environment Variables (prefixed with VITE_) ---
# When deployed together on Vercel, this can be empty or set to /api
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
